# Environment Variables Example for Hirely AI
# Copy to .env file dan sesuaikan nilai-nilainya

# ===== UVICORN SERVER =====
# Host untuk server (0.0.0.0 untuk accessible dari luar)
UVICORN_HOST=0.0.0.0

# Port untuk server (7860 untuk Hugging Face default)
UVICORN_PORT=7860

# ===== LOGGING =====
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===== APPLICATION =====
# Environment (development, staging, production)
ENVIRONMENT=production

# Debug mode (False untuk production)
DEBUG=False

# ===== MODEL CONFIGURATION =====
# Path ke model file (relative ke /app)
MODEL_PATH=/app/model/skill_gap_model.keras

# Path ke labels file
LABELS_PATH=/app/model/skill_labels.json

# Path ke vectorizer file
VECTORIZER_PATH=/app/model/tfidf_vectorizer.pkl

# ===== API CONFIGURATION =====
# API title
API_TITLE=Hirely AI - CV Analyzer

# API version
API_VERSION=1.0.0

# API description
API_DESCRIPTION=AI-powered CV analyzer for skill gap detection

# ===== CORS CONFIGURATION =====
# Allowed origins untuk CORS (comma-separated)
ALLOWED_ORIGINS=*

# ===== UVICORN ADVANCED =====
# Number of workers
WORKERS=1

# Reload on code change (False untuk production)
RELOAD=False

# SSL certificate path (optional)
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

# ===== DATABASE (jika diperlukan di masa depan) =====
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ===== CACHE =====
# Redis URL untuk caching (optional)
# REDIS_URL=redis://localhost:6379

# ===== SECURITY =====
# Secret key untuk JWT atau session
# SECRET_KEY=your-secret-key-here

# ===== MONITORING =====
# Sentry DSN untuk error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# ===== FEATURE FLAGS =====
# Enable/disable tertentu features
# ENABLE_FEATURE_X=True
# ENABLE_FEATURE_Y=False

# ===== EXTERNAL SERVICES =====
# API keys untuk external services (jika ada)
# EXTERNAL_API_KEY=your-api-key
# EXTERNAL_API_SECRET=your-api-secret

# ===== NOTES =====
# Untuk production di Hugging Face, gunakan secrets management
# Jangan commit .env file (sudah di .gitignore)
# Copy nilai dari .env ke Hugging Face Secrets
